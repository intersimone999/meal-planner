# Meal Planner — copy this file to `.env` and fill in the values.
# The compose stack REFUSES to start if the two required values are empty.

# ---- Required ----------------------------------------------------------

# Master password shown on the login page (single-user auth).
MENUAPP_PASSWORD=

# Signing key for the session cookie. Any long random string; keep it
# secret. Changing it invalidates every existing session. Suggested:
#   openssl rand -hex 32
MENUAPP_SESSION_SECRET=


# ---- Optional (defaults shown, kept commented) -------------------------

# Host-side port. Bound to 127.0.0.1 only — Apache proxies to it.
#MEAL_PLANNER_PORT=8000

# Where the SQLite DB lives on the host (bind-mounted to /data in the
# container). On a real server use e.g. /var/lib/meal-planner.
#MEAL_PLANNER_DATA_DIR=./data

# URL sub-path where Apache mounts the app. Set to an empty string to
# serve at the origin root ("/") instead of "/meal-planner".
#MENUAPP_ROOT_PATH=/meal-planner

# true when serving over HTTPS (marks the session cookie Secure).
#MENUAPP_HTTPS_ONLY=false

# Image tag and container name are hardcoded in docker-compose.yml —
# override by editing that file or via a docker-compose.override.yml.
