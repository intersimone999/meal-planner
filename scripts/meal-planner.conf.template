# Meal Planner — server-wide reverse-proxy config.
#
# Installed by scripts/install-apache-config.sh as
#   /etc/apache2/conf-available/meal-planner.conf
# then enabled via `a2enconf meal-planner`. Placeholders __PORT__ and
# __ROOT_PATH__ are substituted at install time.
#
# Deliberately NOT wrapped in a <VirtualHost> block. On a stock
# Debian/Ubuntu Apache the default listener (`000-default.conf`) already
# captures *:80 without a ServerName, so an additional VirtualHost on
# *:80 doesn't get matched. Instead we add ProxyPass at server scope so
# the rule applies to whichever vhost handles the request — including
# the default one.
#
# IMPORTANT: this config STRIPS the sub-path when proxying. The uvicorn
# in the container runs with --root-path=/meal-planner (set via
# MENUAPP_ROOT_PATH in the compose env). uvicorn re-prepends the prefix
# to scope["path"] as it reads the request; Starlette's routing then
# strips it internally via get_route_path(). Net: routes registered as
# /login match a request originally addressed to /meal-planner/login.
# Do NOT keep the prefix in the ProxyPass target — you'd end up with
# scope["path"] = "/meal-planner/meal-planner/login" (double prefix).

ProxyRequests Off
ProxyPreserveHost On
RequestHeader set X-Forwarded-Proto "%{REQUEST_SCHEME}s"

# Canonicalise /meal-planner → /meal-planner/  (needed so ProxyPass
# below, which is anchored on the trailing slash, actually matches).
RedirectMatch permanent "^__ROOT_PATH__$" "__ROOT_PATH__/"

# Target ends with "/" (no sub-path) — Apache strips the source prefix.
ProxyPass         "__ROOT_PATH__/" "http://127.0.0.1:__PORT__/"
ProxyPassReverse  "__ROOT_PATH__/" "http://127.0.0.1:__PORT__/"
